# shellcheck shell=bash

# shellcheck disable=SC1091
[[ $(uname) == "Darwin" ]] && . "/Users/graham/Code/asystem/src/all/media/.env"
# shellcheck disable=SC1091
[[ $(uname) == "Linux" ]] && . "/root/install/media/latest/.env"

# Output flags, passed between media scripts rather than typed by a user
#   MEDIA_REMOTE set by deploy.sh over ssh, colours section headers
#   MEDIA_NESTED set by callers running media.sh as a step, suppresses its trailing blank line
#   MEDIA_SEPARATE set after the first file action runs, prints a blank line between files
#   MEDIA_BIN_DIR override the bin directory generated scripts run from, defaults to the installed latest
MEDIA_REMOTE="${MEDIA_REMOTE:-}"
MEDIA_NESTED="${MEDIA_NESTED:-}"

[[ $(uname) == "Darwin" ]] && export FIND_CMD=gfind
[[ $(uname) == "Linux" ]] && export FIND_CMD=find

[[ $(uname) == "Darwin" ]] && export PYTHON_DIR=${PYENV_ROOT}/versions/asystem/bin
[[ $(uname) == "Linux" ]] && export PYTHON_DIR=/root/.pyenv/versions/${ASYSTEM_PYTHON_VERSION}/bin

[[ $(uname) == "Darwin" ]] && export LIB_ROOT=/var/lib/asystem/install/media/latest/bin/lib
[[ $(uname) == "Linux" ]] && export LIB_ROOT=/var/lib/asystem/install/media/latest/bin/lib

[[ $(uname) == "Darwin" ]] && export SHARE_ROOT=/Users/graham/Desktop/share
[[ $(uname) == "Linux" ]] && export SHARE_ROOT=/share

SHARE_DIRS=$(find "${SHARE_ROOT}" -mindepth 1 -maxdepth 1 -type d | sort)
export SHARE_DIRS

[[ $(uname) == "Darwin" ]] && SHARE_DIRS_LOCAL=${SHARE_DIRS}
[[ $(uname) == "Linux" ]] && SHARE_DIRS_LOCAL=$(grep -v '^#' /etc/fstab | grep '/share' | grep ext4 | awk 'BEGIN{FS=OFS=" "}{print $2}' | sort)
export SHARE_DIRS_LOCAL

export SHARE_DIR=""
for _SHARE_DIR in ${SHARE_DIRS}; do
  [[ ${PWD} == ${_SHARE_DIR}* ]] && export SHARE_DIR=${_SHARE_DIR}
done

export SHARE_DIR_MEDIA=""
for _SHARE_DIR in ${SHARE_DIRS}; do
  [[ ${PWD} == ${_SHARE_DIR}/media* ]] && export SHARE_DIR_MEDIA=${_SHARE_DIR}/media
done

print_header() {
  local host="${1}" stage="${2}" remote="${3}"
  if [ "${remote}" -eq 1 ] || [ -n "${MEDIA_REMOTE}" ]; then
    printf '\n\033[1;35m== %s %s ==\033[0m\n\n' "${host}" "${stage}"
  else
    printf '\n== %s %s ==\n\n' "${host}" "${stage}"
  fi
}
