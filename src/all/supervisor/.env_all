SUPERVISOR_MOUNT=/host
SUPERVISOR_LOG_LEVEL=info

BROKER_HOST=$VERNEMQ_SERVICE
BROKER_PORT=$VERNEMQ_API_PORT
BROKER_TOKEN=$VERNEMQ_ACCESS_KEY

DATABASE_HOST=$INFLUXDB3_SERVICE
DATABASE_PORT=$INFLUXDB3_API_PORT
DATABASE_NAME=$INFLUXDB3_DATABASE_HOME
DATABASE_TOKEN=$INFLUXDB3_TOKEN_ADMIN

TZ=Australia/Perth

SUPERVISOR_ROOT_SOURCE=/
SUPERVISOR_FSTAB_SOURCE=/etc/fstab
SUPERVISOR_BTRFS_SOURCE=/var/lib/btrfs
SUPERVISOR_INSTALL_SOURCE=/var/lib/asystem/install
SUPERVISOR_HOME_SOURCE=/home/asystem
SUPERVISOR_SHARE_SOURCE=/share
SUPERVISOR_BACKUP_SOURCE=/backup
SUPERVISOR_DEV_SOURCE=/dev
SUPERVISOR_DEV_TARGET=/dev
SUPERVISOR_BIND_PROPAGATION=rshared
