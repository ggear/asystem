{
  "asystem": {
    "version": "$SERVICE_VERSION_ABSOLUTE",
    "host": "$SUPERVISOR_HOST",
    "mount": "$SUPERVISOR_MOUNT",
    "broker": {
      "host": "$BROKER_HOST",
      "port": "$BROKER_PORT",
      "token": "$BROKER_TOKEN"
    },
    "database": {
      "host": "$DATABASE_HOST",
      "port": "$DATABASE_PORT",
      "name": "$DATABASE_NAME",
      "token": "$DATABASE_TOKEN"
    },
    "schema": [
      {
        "host": "macmini-mad",
        "index": 1,
        "services": [
          "network",
          "plex",
          "postgres",
          "sabnzbd",
          "supervisor",
          "wrangle"
        ]
      },
      {
        "host": "macmini-max",
        "index": 2,
        "services": [
          "influxdb3",
          "mlflow",
          "mlserver",
          "openra",
          "supervisor"
        ]
      },
      {
        "host": "macmini-may",
        "index": 3,
        "services": [
          "cloudflare",
          "grafana",
          "letsencrypt",
          "sonarr",
          "supervisor",
          "tempstat"
        ]
      },
      {
        "host": "macmini-meg",
        "index": 4,
        "services": [
          "homeassistant",
          "mariadb",
          "nginx",
          "supervisor",
          "tasmota",
          "vernemq"
        ]
      },
      {
        "host": "raspbpi-jen",
        "services": [
          "supervisor",
          "weewx",
          "zigbee2mqtt"
        ]
      },
      {
        "host": "raspbpi-jil",
        "services": [
          "supervisor"
        ]
      }
    ],
    "backup": {
      "command_topic": "tasmota/device/rack_backup_plug/cmnd/POWER",
      "state_topic": "tasmota/device/rack_backup_plug/stat/POWER",
      "timeout_hours": 3,
      "keep_daily": 7,
      "keep_weekly": 4,
      "keep_monthly": 12
    }
  }
}