MLFLOW_HTTP_PORT=32413
MLFLOW_HTTP_MAX_BODY=256m
MLFLOW_TRACKING_URI=https://mlflow.proxy.janeandgraham.com
MLFLOW_REPOSITORY_URI=https://mlflow.proxy.janeandgraham.com
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER_MLFLOW}:${POSTGRES_KEY_MLFLOW}@${POSTGRES_HOST}:${POSTGRES_API_PORT}/${POSTGRES_DATABASE_MLFLOW}
MLFLOW_DEFAULT_ARTIFACT_ROOT=mlflow-artifacts:/
MLFLOW_ARTIFACTS_DESTINATION=/asystem/mnt/artifacts
MLFLOW_ARTIFACTS_DIR_SERVER=${MLFLOW_SHARE_SERVER_DIR}${MLFLOW_ARTIFACT_DIR}
MLFLOW_ALLOWED_HOSTS=mlflow.proxy.janeandgraham.com,mlflow.janeandgraham.com,mlflow.local.janeandgraham.com,host.docker.internal:*,localhost:*,127.0.0.1:*,10.*,192.168.*,172.*
MLFLOW_CORS_ALLOWED_ORIGINS=https://mlflow.proxy.janeandgraham.com,https://mlflow.janeandgraham.com,http://localhost:*
MLFLOW_DISABLE_TELEMETRY=true
