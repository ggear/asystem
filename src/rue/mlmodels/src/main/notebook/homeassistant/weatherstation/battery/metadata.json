          "datatype": "INT64",
          "shape": [1],
          "parameters": {"unit": "percent", "required": true, "description": "Estimated battery capacity left, in steps of 5, 0 to 100, one level across the 3.77 to 3.83 V plateau."}
        },
        {
          "name": "weatherstation_console_battery_capacity_pct_valid",
          "datatype": "INT64",
          "shape": [1],
          "parameters": {"unit": "flag", "required": true, "description": "1 when the capacity is a prediction, 0 when the voltage was flagged not valid and the capacity is 0."}
        }
