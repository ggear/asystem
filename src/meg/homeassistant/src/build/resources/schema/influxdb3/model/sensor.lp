#   field state - <on-change> [Home Assistant value]
#   field value - <on-change> [Home Assistant value]
#   field warnings_str - <on-change> [Home Assistant value]

sensor,
  module=homeassistant,
  entity_id=<string>,
  unit_of_measurement=<string>
    color_fill=<float>,
    color_fill_str=<text>,
    color_text=<float>,
    color_text_str=<text>,
    state=<text>,
    value=<float>,
    warnings_str=<text>
  <timestamp>
