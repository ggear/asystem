#   field value - <on-change> [Home Assistant value]

switch,
  module=homeassistant,
  entity_id=<string>
    assumed_state=<float>,
    brightness_pct=<float>,
    force_rgb_color=<float>,
    rgb_color=<float>,
    sun_position=<float>,
    value=<float>
  <timestamp>
